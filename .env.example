# ============================================================
#  Lestha Send — configuration (copiez ce fichier en .env)
# ============================================================

# URL publique de l'application (utilisée dans les liens envoyés par e-mail)
PUBLIC_URL=https://transferx.exemple.com
PORT=3000

# Secret de signature (jetons PIN, URLs). Chaîne longue et aléatoire.
# Si absent, un secret est généré puis conservé dans le stockage.
APP_SECRET=

# ---------- Stockage Cloudflare R2 (recommandé) ----------
# Tableau de bord Cloudflare → R2 → Créer un bucket, puis « Gérer les jetons API R2 »
# (permission : Lecture et écriture d'objets, limitée à ce bucket)
R2_ACCOUNT_ID=
R2_BUCKET=transferx
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Ou tout autre stockage compatible S3 (AWS, Backblaze B2, MinIO…) ---
# S3_BUCKET=
# S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Ou disque local du serveur (développement / VPS) ---
# STORAGE_DRIVER=local
# DATA_DIR=./data

# ---------- Protection de l'origine (IMPORTANT) ----------
# Cloudflare ajoute cet en-tête secret à chaque requête (Rules › Transform Rules › Modify Request Header :
# définir X-Origin-Secret). Le serveur refuse alors toute requête qui contourne Cloudflare, ce qui rend
# l'adresse IP des visiteurs fiable pour les limites anti-abus. 16 caractères minimum.
# ⚠ Créez d'abord la règle Cloudflare, PUIS renseignez cette variable : sinon le site refuse tout le monde.
ORIGIN_SECRET=

# ---------- Anti-robot Cloudflare Turnstile (optionnel, gratuit) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---------- Offres du mode Cloud ----------
# Sans compte
FREE_MAX_GB=2
FREE_MAX_DAYS=3
FREE_DAILY_TRANSFERS=10        # par connexion (une même adresse publique peut regrouper plusieurs personnes)
# Adresse e-mail confirmée par un code
VERIFIED_MAX_GB=10
VERIFIED_MAX_DAYS=7
VERIFIED_DAILY_TRANSFERS=20
EMAIL_MAX_RECIPIENTS=3         # destinataires e-mail par envoi
# Garde-fous globaux
EMAIL_DAILY_CAP=300            # e-mails envoyés par jour, tous usages confondus
REPORT_THRESHOLD=3             # signalements distincts avant suspension automatique d'un lien
ADMIN_EMAIL=                   # reçoit les signalements
CONTACT_EMAIL=                 # affiché sur les pages Conditions et Confidentialité
APP_NAME=Lestha Send

# ---------- Accès ----------
# Optionnel : code exigé pour CRÉER un envoi (les destinataires n'en ont jamais besoin).
# Recommandé pour une instance d'établissement : évite que des inconnus remplissent votre stockage.
UPLOAD_CODE=

# ---------- Console d'administration (v3.1) ----------
# Mot de passe de la console (12 caractères minimum conseillés). Vide = console désactivée.
ADMIN_PASSWORD=
# Adresse discrète de la console : https://votre-app/<ADMIN_PATH>  (par défaut : admin)
ADMIN_PATH=admin

# Garde-fou : sur Render sans R2, le mode Cloud est désactivé (liens effacés à chaque redémarrage).
# Ne mettez true que si vous avez attaché un disque persistant Render.
ALLOW_LOCAL_STORAGE=false

# ---------- Limites ----------
MAX_TRANSFER_GB=250          # taille max d'un envoi
MAX_FILES=10000              # nombre max de fichiers par envoi
MAX_TTL_DAYS=30              # durée de vie max d'un lien
MAX_TRANSFERS_PER_HOUR=60    # anti-abus, par adresse IP
STORAGE_QUOTA_GB=200         # plafond réel : au-delà, les nouveaux envois Cloud sont refusés (le mode Direct reste disponible)

# ---------- E-mail (optionnel) ----------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# ou SMTP :
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------- Mode Direct P2P : serveur TURN (optionnel, conseillé) ----------
# Plusieurs URLs possibles, séparées par des virgules
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Classe virtuelle BigBlueButton (optionnel) ----------
# URL publique BBB sans /api, ex. https://bbb.exemple.org/bigbluebutton
# Le secret API est le securitySalt BBB et ne doit jamais être exposé au navigateur.
BBB_URL=
BBB_SECRET=
# Maximum par salle selon votre abonnement BBB (2 par défaut pour l’offre d’essai).
BBB_MAX_PARTICIPANTS=2
# Code aléatoire d'au moins 16 caractères réservé aux enseignants.
CLASSROOM_CREATE_CODE=
