# ============================================================
#  TransferX — configuration (copiez ce fichier en .env)
# ============================================================

# URL publique de l'application (utilisée dans les liens envoyés par e-mail)
PUBLIC_URL=https://transferx.exemple.com
PORT=3000

# Secret de signature (jetons PIN, URLs). Chaîne longue et aléatoire.
# Si absent, un secret est généré puis conservé dans le stockage.
APP_SECRET=

# ---------- Stockage Cloudflare R2 (recommandé) ----------
# Tableau de bord Cloudflare → R2 → Créer un bucket, puis « Gérer les jetons API R2 »
# (permission : Lecture et écriture d'objets, limitée à ce bucket)
R2_ACCOUNT_ID=
R2_BUCKET=transferx
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Ou tout autre stockage compatible S3 (AWS, Backblaze B2, MinIO…) ---
# S3_BUCKET=
# S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Ou disque local du serveur (développement / VPS) ---
# STORAGE_DRIVER=local
# DATA_DIR=./data

# ---------- Accès ----------
# Optionnel : code exigé pour CRÉER un envoi (les destinataires n'en ont jamais besoin).
# Recommandé pour une instance d'établissement : évite que des inconnus remplissent votre stockage.
UPLOAD_CODE=

# ---------- Limites ----------
MAX_TRANSFER_GB=250          # taille max d'un envoi
MAX_FILES=10000              # nombre max de fichiers par envoi
MAX_TTL_DAYS=30              # durée de vie max d'un lien
MAX_TRANSFERS_PER_HOUR=60    # anti-abus, par adresse IP
STORAGE_QUOTA_GB=            # optionnel : affiche une jauge dans le tableau de bord

# ---------- E-mail (optionnel) ----------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# ou SMTP :
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------- Mode Direct P2P : serveur TURN (optionnel, conseillé) ----------
# Plusieurs URLs possibles, séparées par des virgules
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
